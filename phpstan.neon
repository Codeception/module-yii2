includes:
    - phpstan-baseline.neon
parameters:
    exceptions:
        check:
            missingCheckedExceptionInThrows: false
        reportUncheckedExceptionDeadCatch: false
    reportUnmatchedIgnoredErrors: true
    editorUrl: "phpstorm://open?file=%%file%%&line=%%line%%"
    dynamicConstantNames:
      - CONSOLE
      - YII_DEBUG
    level: 9
    paths:
      - src
      - tests
    checkMaybeUndefinedVariables: true
    treatPhpDocTypesAsCertain: false
    # The actor action classes are generated by `codecept build`; skip their
    # analysis (their `never`-typed actions cannot be verified statically)
    # while still scanning them so the actor classes remain discoverable.
    excludePaths:
        analyse:
            - tests/_support/_generated/*
    # If you want to ignore missing generics errors in the future, you can add:
    # - identifier: missingType.generics
    stubFiles:
        - tests/Yii.stub
